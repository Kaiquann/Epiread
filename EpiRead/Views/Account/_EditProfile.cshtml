@model ProfileVm

<partial name="_SweetAlert"/>

<style>
    body, .profile-bg { background: #23262F !important; }

    .profile-card {
        align-items: center;
        background: #23262F;
        border: 1.5px solid #444a57;
        border-radius: 18px;
        box-shadow: 0 2px 24px 0 rgba(0, 0, 0, 0.25);
        color: #e0e0e0;
        display: flex;
        justify-content: center;
        min-height: 340px;
        padding: 2.5rem 2rem;
    }

    .profile-img-wrapper {
        align-items: center;
        background: #292c36;
        border: 3px solid #383D48;
        border-radius: 50%;
        box-shadow: 0 2px 12px rgba(108, 99, 255, 0.10);
        display: flex;
        height: 140px;
        justify-content: center;
        margin-bottom: 1rem;
        overflow: hidden;
        position: relative;
        width: 140px;
    }

    .profile-img-wrapper img {
        border-radius: 50%;
        display: block;
        height: auto;
        margin: 0 auto;
        max-height: 100%;
        max-width: 100%;
        object-fit: cover;
        width: auto;
    }

    .upload-overlay {
        align-items: center;
        background: rgba(44, 48, 60, 0.85);
        border-bottom-left-radius: 50%;
        border-bottom-right-radius: 50%;
        bottom: 0;
        color: #6c63ff;
        cursor: pointer;
        display: flex;
        font-size: 1.3rem;
        height: 36px;
        justify-content: center;
        left: 0;
        opacity: 0;
        position: absolute;
        right: 0;
        transition: opacity 0.2s;
        width: 100%;
    }

    .upload:hover .upload-overlay, .upload:focus .upload-overlay { opacity: 1; }

    .profile-name {
        color: #fff;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .profile-label {
        color: #b0b0b0;
        font-size: 1.04rem;
        font-weight: 500;
        text-align: right;
    }

    .profile-btn {
        border-radius: 8px;
        font-size: 1.04rem;
        font-weight: 500;
        min-width: 150px;
        padding: 0.45rem 1.1rem;
        transition: background 0.2s, color 0.2s, border 0.2s;
    }

    .btn-success {
        background: #4be37a;
        border-color: #4be37a;
        color: #23262F;
    }

    .btn-success:hover, .btn-success:focus {
        background: #38c96a;
        border-color: #38c96a;
        color: #fff;
    }

    .btn-danger {
        background: #ff5c5c;
        border-color: #ff5c5c;
        color: #23262F;
    }

    .btn-danger:hover, .btn-danger:focus {
        background: #e04a4a;
        border-color: #e04a4a;
        color: #fff;
    }

    .btn-secondary {
        background: #444a57;
        border-color: #444a57;
        color: #e0e0e0;
    }

    .btn-secondary:hover, .btn-secondary:focus {
        background: #383d48;
        border-color: #383d48;
        color: #fff;
    }

    .field-label {
        color: #b0b0b0;
        font-size: 1rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        margin-bottom: 0.3rem;
    }

    .field-input {
        background: transparent;
        border: none;
        border-bottom: 2px solid #444a57;
        border-radius: 0;
        box-shadow: none;
        color: #fff;
        font-size: 1.1rem;
        outline: none;
        padding-left: 0;
        padding-right: 0;
    }

    .field-input:focus {
        background: transparent;
        border-bottom: 2px solid #4be37a;
        box-shadow: none;
        color: #fff;
    }

    .custom-select-dark {
        background-color: #292c36 !important;
        border: 1.5px solid #444a57 !important;
        color: #fff !important;
        font-size: 1.1rem;
        border-radius: 8px;
        padding: 0.6rem 1rem;
        appearance: none;
    }

    .custom-select-dark:focus {
        border-color: #4be37a !important;
        box-shadow: 0 0 0 0.2rem rgba(75, 227, 122, 0.25);
        background-color: #2f323c !important;
        color: #fff !important;
    }

    .custom-select-dark option {
        background-color: #23262F;
        color: #fff;
    }

</style>

<form data-ajax="true"
      data-ajax-update="#ajax-update-content"
      asp-area=""
      asp-controller="Account"
      asp-action="RemoveProfileImage"
      method="post"
      id="removeProfileImageForm">
</form>

<form data-ajax="true"
      data-ajax-update="#ajax-update-content"
      asp-area=""
      asp-controller="Account"
      asp-action="EditProfile"
      method="post"
      enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="container my-5 profile-bg" style="min-height: 70vh;">
        <div class="profile-card shadow-lg border-0 p-4 d-flex align-items-center justify-content-center" style="margin: 0 auto; max-width: 900px;">
            <div class="row w-100 g-4 align-items-center justify-content-center m-0">
                <!-- Left: Profile Image Upload -->
                <div class="col-md-4 d-flex flex-column align-items-center justify-content-center border-md-end" style="min-height: 320px;">
                    <div class="profile-img-wrapper mb-3">
                        <label class="upload position-relative d-inline-block">
                            <input asp-for="ProfileImage" accept="image/jpeg,image/png" hidden>
                            <partial name="User/_ProfileImagePartial" model="@Model.ProfileImageLink"/>
                            <span class="upload-overlay">
                                <i class="fas fa-camera"></i>
                            </span>
                        </label>
                        <span asp-validation-for="ProfileImage" class="text-danger"></span>
                    </div>
                    <div class="w-100 mt-2">
                        <button class="btn btn-danger w-100 mb-2 profile-btn"
                                data-confirm="Are you sure to remove profile image?"
                                form="removeProfileImageForm">
                            <i class="fas fa-trash me-2" aria-hidden="true"></i> Remove Profile Image
                        </button>
                    </div>
                </div>
                <!-- Right: Editable Fields -->
                <div class="col-md-8">
                    <h1 class="mb-4 fw-bold" style="font-size: 2.1rem; letter-spacing: -1px;">Edit Profile</h1>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-4">
                        <label asp-for="FirstName" class="form-label field-label"></label>
                        <input asp-for="FirstName" class="form-control field-input"/>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="LastName" class="form-label field-label"></label>
                        <input asp-for="LastName" class="form-control field-input"/>
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="UserName" class="form-label field-label"></label>
                        <input asp-for="UserName" class="form-control field-input"/>
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Birthday" class="form-label field-label"></label>
                        <input asp-for="Birthday" type="date" class="form-control field-input" />
                        <span asp-validation-for="Birthday" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Language" class="form-label field-label"></label>
                        <select asp-for="Language" asp-items="ViewBag.Languages" class="form-select field-input custom-select-dark">
                        </select>
                        <span asp-validation-for="Language" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 gap-2">
                        <a asp-area="" asp-controller="Account" asp-action="Profile" class="btn btn-secondary profile-btn">
                            <i class="fas fa-times me-2" aria-hidden="true"></i> Cancel
                        </a>
                        <button class="btn btn-success profile-btn" data-confirm>
                            <i class="fas fa-save me-2" aria-hidden="true"></i> Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    // Ensure birthday cannot be after today (client-side only)
    (function(){
        var $birthday = $("input[name='Birthday']");
        if ($birthday.length === 0) return;

        // set max attr to today in yyyy-mm-dd
        var today = new Date();
        var yyyy = today.getFullYear();
        var mm = (today.getMonth() + 1).toString().padStart(2, '0');
        var dd = today.getDate().toString().padStart(2, '0');
        var todayStr = yyyy + '-' + mm + '-' + dd;
        $birthday.attr('max', todayStr);

        var $msg = $("span[data-valmsg-for='Birthday']");

        // On change, validate
        $birthday.on('change input', function(){
            var val = $(this).val();
            if (!val) { $msg.text(''); return; }
            if (val > todayStr) {
                $msg.text('Birthday cannot be after today.');
            } else {
                $msg.text('');
            }
        });

        // On submit prevent future birthday
        $('#editProfileForm').on('submit', function(e){
            var val = $birthday.val();
            if (val && val > todayStr) {
                e.preventDefault();
                $msg.text('Birthday cannot be after today.');
                // scroll to error
                $('html, body').animate({ scrollTop: $msg.offset().top - 120 }, 200);
                return false;
            }
            return true;
        });
    })();
</script>