﻿@using Microsoft.AspNetCore.Authentication

<ul id="dropdownMenu" class="dropdown-menu dropdown-menu-end my-3">
    @if (User.IsLoggedIn())
    {
        <li class="nav-item">
            <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">
                <i class="fas fa-user me-2"></i>Profile
            </a>
        </li>

        <li>
            <hr class="dropdown-divider">
        </li>
        <li class="nav-item">
            <a class="dropdown-item" asp-area="" asp-controller="Book" asp-action="PreferenceBook">
                <i class="fas fa-heart me-2"></i>Book Preference
            </a>
        </li>
        <li class="nav-item">
            <a class="dropdown-item" asp-area="" asp-controller="Book" asp-action="BookHistory">
                <i class="fas fa-book me-2"></i>Book History
            </a>
        </li>

        @if (User.IsInRole(nameof(UserRoleType.Author)))
        {
            <li>
                <hr class="dropdown-divider">
            </li>
            <li class="dropdown-header text-muted small">Author Dashboard</li>
            <li class="nav-item">
                <a class="dropdown-item" asp-area="Author" asp-controller="Book" asp-action="Index">
                    <i class="fas fa-book me-2"></i>My Books
                </a>
            </li>
            <li class="nav-item">
                <a class="dropdown-item" asp-area="Author" asp-controller="Book" asp-action="Create">
                    <i class="fas fa-plus-circle me-2"></i>Publish New Book
                </a>
            </li>
        }

        @if (User.HasAdminAccess())
        {
            <li>
                <hr class="dropdown-divider">
            </li>
            <li class="dropdown-header text-muted small">Admin Panel</li>
            <li class="nav-item">
                <a class="dropdown-item" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="fas fa-shield-alt me-2"></i>Admin Dashboard
                </a>
            </li>
        }

        <li>
            <hr class="dropdown-divider">
        </li>
        <li class="nav-item">
            <a class="dropdown-item" asp-area="" asp-controller="LoginHistory" asp-action="Index">
                <i class="fas fa-history me-2"></i>Login History
            </a>
        </li>

        <li class="nav-item">
            <a class="dropdown-item text-danger" data-post="/Account/Logout" data-confirm="Are you sure you want to log out?">
                <i class="fas fa-sign-out-alt me-2"></i>Logout
            </a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="dropdown-item" asp-area="" asp-controller="Register" asp-action="Index">
                <i class="fas fa-user-plus me-2"></i>Register
            </a>
        </li>
        <li class="nav-item">
            <a class="dropdown-item" asp-area="" asp-controller="Login" asp-action="Index">
                <i class="fas fa-sign-in-alt me-2"></i>Login
            </a>
        </li>
    }
</ul>