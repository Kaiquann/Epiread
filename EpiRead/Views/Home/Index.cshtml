@model HomeVm
@{
    ViewBag.Title = "Welcome to " + Common.CompanyName;
}
<style>
    body {
        background-color: #383D48;
        color: white;
    }

    .hero {
        align-items: center;
        background: linear-gradient(135deg, #546063, #2e55b3);
        display: flex;
        justify-content: space-between;
        padding: 100px 10%;
    }

    .hero-text h1 {
        color: #fff;
        font-size: 3rem;
        font-weight: bold;
    }

    .hero-text p {
        color: #ccc;
        font-size: 1.2rem;
        margin: 20px 0;
    }

    .hero-text .btn {
        background: #6c63ff;
        border-radius: 25px;
        color: #fff;
        font-weight: bold;
        padding: 12px 30px;
    }

    .slider {
        border-radius: 10px;
        height: 400px;
        overflow: hidden;
        position: relative;
        width: 300px;
    }

    .slider img {
        height: 100%;
        left: 0;
        object-fit: cover;
        position: absolute;
        top: 0;
        transition: opacity 0.5s ease-in-out;
        width: 100%;
    }

    /* Book category image sizing */
    .bookCategory img {
        height: 220px;
        width: 150px;
        object-fit: cover;
    }

    .bookCategory {
        box-shadow: 0 4px 6px rgba(255 255 255 / 10%);
    }


    /*features box*/
    .features {
        padding: 80px 10%;
        text-align: center;
    }

    .feature-box {
        background: #1c1c1c;
        border-radius: 10px;
        padding: 30px;
        transition: 0.3s;
    }

    .feature-box:hover {
        background: #292929;
        transform: translateY(-5px);
    }


    < !--Treding book-->.trending-books {
        background: #1a1a1a;
        color: #fff;
    }

    .book-carousel {
        align-items: center;
        display: flex;
        justify-content: center;
        position: relative;
        width: 100%;
    }

    .carousel-wrapper {
        margin: 0 auto;
        overflow: hidden;
        position: relative;
        width: 80%;
    }

    .carousel-track {
        display: flex;
        overflow-x: scroll;
        scroll-behavior: smooth;
        scrollbar-width: none;
    }

    .carousel-track::-webkit-scrollbar {
        display: none;
    }

    .book-item {
        flex: 0 0 250px;
        margin: 0 10px;
        text-align: center;
    }

    .book-item img {
        border-radius: 8px;
        height: 320px;
        object-fit: cover;
        width: 100%;
    }

    .carousel-btn {
        background-color: rgba(0, 0, 0, 0.5);
        border: none;
        border-radius: 50%;
        color: white;
        cursor: pointer;
        font-size: 2rem;
        padding: 10px;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        transition: background 0.3s;
        z-index: 10;
    }

    .carousel-btn:hover {
        background-color: rgba(0, 0, 0, 0.8);
    }

    .left-btn {
        left: 10px;
    }

    .right-btn {
        right: 10px;
    }


    .newsletter {
        background: #141414;
        padding: 60px 10%;
        text-align: center;
    }

    .newsletter input {
        margin: auto;
        max-width: 400px;
    }

    .card {
        height: 558px;
    }

    .card-image {
        min-height: 414px;
    }

    .card img {
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .card-body {
        background-color: #272323;
        min-height: 170px;
    }

    /* Personalized summary removed - recommendations only */

    /* Recommended cards layout */
    .recommended-cards {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: nowrap;
        overflow-x: auto;
        padding: 20px 10px;
    }

    .rec-card {
        flex: 0 0 200px;
        /* fixed card width */
        max-width: 200px;
    }

    .rec-card .card-image img {
        height: 320px;
        object-fit: cover;
        width: 100%;
    }

    .rec-card .card-body {
        min-height: 110px;
        overflow: hidden;
    }

    /* Small screens: allow wrapping */
    @@media (max-width: 768px) {
        .recommended-cards {
            flex-wrap: nowrap;
        }

        .rec-card {
            flex: 0 0 160px;
            max-width: 160px;
        }

        .rec-card .card-image img {
            height: 240px;
        }
    }
</style>

<div class="home-page">
<!-- Top section -->
<section class="hero">
    <div class="hero-text">
        <span class="hero-eyebrow"><i class="bi bi-stars"></i> Your next chapter starts here</span>
        <h1>Books that feel<br><span>chosen for you.</span></h1>
        <p>Explore thoughtful recommendations, keep your reading journey in one place, and connect with a community that loves a good story.</p>
        <div class="hero-actions">
            <a asp-area="" asp-controller="Book" asp-action="Index" class="btn hero-primary">Explore the library <i class="bi bi-arrow-right"></i></a>
            <a asp-area="" asp-controller="Home" asp-action="AboutUs" class="btn hero-secondary">How EpiRead works</a>
        </div>
        <div class="hero-proof" aria-label="Platform highlights">
            <span><i class="bi bi-lightning-charge-fill"></i> Smart discovery</span>
            <span><i class="bi bi-people-fill"></i> Reader community</span>
        </div>
    </div>
    <div class="hero-visual">
      <div id="book-slider" class="slider">
        @foreach (var book in Model.TrendingBooks.Take(4)) //swap image every 2 seconds
        {
            var imgSrc = string.IsNullOrWhiteSpace(book.CoverImageLink) ? "/images/book-cover-not-available.webp" :
            book.CoverImageLink;
            <a asp-area="" asp-controller="Book" asp-action="BookDetails" asp-route-id="@book.Id">
                <img src="@imgSrc" alt="@book.Title" class="slide" style="display: block;" loading="lazy">
            </a>
        }
      </div>
      <div class="hero-visual-note"><i class="bi bi-graph-up-arrow"></i><span><strong>Trending now</strong><small>Reader favourites</small></span></div>
    </div>
</section>

<!-- Book Categories Section -->
<section class="home-section category-section">
    <div class="section-heading">
        <div><span class="section-kicker">Curated picks</span><h2>Start with something remarkable</h2></div>
        <a asp-controller="Book" asp-action="Index" class="section-link">View all books <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="category-grid">
        @{
            var preferredBooks = new Book?[]
            {
                Model.NewReleases.FirstOrDefault(),
                Model.MostLiked.FirstOrDefault(),
                Model.TopRated.FirstOrDefault(),
                Model.TrendingBooks.FirstOrDefault()
            };
            var fallbackBooks = Model.NewReleases
                .Concat(Model.MostLiked)
                .Concat(Model.TopRated)
                .Concat(Model.TrendingBooks)
                .GroupBy(book => book.Id)
                .Select(group => group.First())
                .ToList();
            var bgColors = new[] { "rgb(101 116 150)", "#363b3b", "rgb(141 78 78)", "rgb(75 105 92)" };
            var btnColors = new[] { "#5d608b", "#4a4a4a", "#a86d6d", "#426353" };
            var titles = new[] { "New Release.", "Reader Favourite.", "Top Rated.", "Trending Now." };

            var panels = new List<(Book Book, string Title, string Bg, string Btn)>();
            var selectedBookIds = new HashSet<int>();
            for (int i = 0; i < titles.Length; i++)
            {
                var book = preferredBooks[i];
                if (book == null || selectedBookIds.Contains(book.Id))
                    book = fallbackBooks.FirstOrDefault(candidate => !selectedBookIds.Contains(candidate.Id));

                if (book != null)
                {
                    selectedBookIds.Add(book.Id);
                    panels.Add((book, titles[i], bgColors[i], btnColors[i]));
                }
            }
        }

        @foreach (var panel in panels)
        {
            var book = panel.Book;
            var bg = panel.Bg;
            var btn = panel.Btn;
            var imgSrc = string.IsNullOrWhiteSpace(book.CoverImageLink) ? "/images/book-cover-not-available.webp" : book.CoverImageLink;

            <article class="bookCategory" style="--panel-accent: @bg; --button-accent: @btn;">
                <!-- Text Section -->
                <div class="category-copy">
                    <span class="category-label">Featured</span>
                    <h3>@panel.Title</h3>
                    <a asp-area="" asp-controller="Book" asp-action="BookDetails" asp-route-id="@book.Id" class="category-link">Discover <i class="bi bi-arrow-up-right"></i></a>
                </div>

                <!-- Image Section -->
                <div class="category-cover">
                    <a asp-area="" asp-controller="Book" asp-action="BookDetails" asp-route-id="@book.Id">
                        <img src="@imgSrc" alt="@book.Title" loading="lazy">
                    </a>
                </div>
            </article>
        }
    </div>
</section>


<section class="home-section features">
    <div class="features-title section-heading centered-heading">
        <div><span class="section-kicker">Made for readers</span><h2>Everything you need to read better</h2></div>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-box"><span class="feature-icon"><i class="bi bi-search"></i></span>
                <h4>Smart Search</h4>
                <p>Find books easily with AI-driven semantic search.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-box"><span class="feature-icon"><i class="bi bi-magic"></i></span>
                <h4>Personalized Recommendations</h4>
                <p>Get tailored suggestions based on your reading habits.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-box"><span class="feature-icon"><i class="bi bi-chat-heart"></i></span>
                <h4>Community Interaction</h4>
                <p>Join forums, share ideas, and connect with other readers.</p>
            </div>
        </div>
    </div>
</section>


<!-- AJAX placeholders for sections (loaded async to make initial page fast) -->
<div id="trending-container" class="my-4"> <!-- trending partial will be loaded here -->
    <div class="text-center text-muted p-3">Loading trending books…</div>
</div>

<div id="recommend-container"> <!-- recommend partial will be loaded here -->
    <div class="text-center text-muted p-3">Loading recommendations…</div>
</div>

<div id="similar-container"> <!-- similar partial will be loaded here -->
    <div class="text-center text-muted p-3">Loading similar books…</div>
</div>

<!-- Newsletter -->
<section class="newsletter">
    <span class="section-kicker">Your digital bookshelf</span>
    <h2>Make space for your next great read.</h2>
    <p>Join EpiRead for personal recommendations, saved favourites, and a reading experience built around you.</p>

    @if (User.IsLoggedIn())
    {

        <p class="mt-3">Welcome back, <strong>@TempData["Username"]</strong>! 🎉</p>
        <button type="button" class="btn newsletter-button"
            onclick="window.location.href='@Url.Action("Index", "Book")'">
            Browse eBooks
        </button>
    }
    else
    {
        <button type="button" class="btn login-btn newsletter-button"
            onclick="window.location.href='@Url.Action("Index", "Register")'">
            Sign Up
        </button>
        <p>
            Already have an account?
            <a href="@Url.Action("Index", "Login")" class="text-light text-decoration-underline">
                Log in here
            </a>.
        </p>
    }
</section>
</div>

@section Scripts {
    <script>
        //for the image swap
        let index = 0;
        const slides = document.querySelectorAll('.slide');
        if (slides.length > 0) {
            slides[0].style.display = 'block';

            setInterval(() => {
                slides[index].style.display = 'none';
                index = (index + 1) % slides.length;
                slides[index].style.display = 'block';
            },
                2000);
        }

        $(document).ready(function () {
            // carousel navigation uses delegated events so partials loaded later are handled
            const scrollAmount = 300; // distance to move each time

            $(document).on('click', '.right-btn', function () {
                const $carousel = $(this).closest('.book-carousel');
                const $track = $carousel.find('.carousel-track');
                $track.animate({ scrollLeft: `+=${scrollAmount}` }, 400);
            });

            $(document).on('click', '.left-btn', function () {
                const $carousel = $(this).closest('.book-carousel');
                const $track = $carousel.find('.carousel-track');
                $track.animate({ scrollLeft: `-=${scrollAmount}` }, 400);
            });

            // Load the three expensive sections asynchronously so the initial page is fast
            // Trending
            $.get('@Url.Action("GetTrending", "Home")')
                .done(function (html) {
                    // Only insert HTML if the response is not empty/whitespace
                    if ($.trim(html).length > 0) $('#trending-container').html(html);
                    else $('#trending-container').empty();
                })
                .fail(function () { $('#trending-container').empty(); });

            // Recommended (personalized)
            $.get('@Url.Action("GetRecommend", "Home")')
                .done(function (html) {
                    if ($.trim(html).length > 0) $('#recommend-container').html(html);
                    else $('#recommend-container').empty();
                })
                .fail(function () { $('#recommend-container').empty(); });

            // Similar
            $.get('@Url.Action("GetSimiliar", "Home")')
                .done(function (html) {
                    if ($.trim(html).length > 0) $('#similar-container').html(html);
                    else $('#similar-container').empty();
                })
                .fail(function () { $('#similar-container').empty(); });
        });

    </script>
}
