@if (!string.IsNullOrEmpty(Convert.ToString(TempData[SweetAlert.Info])))
{
    <script>
        Swal.fire({
            icon: 'info',
            title: 'Info',
            text: '@Html.Raw(TempData[SweetAlert.Info])',
            timer: 5000,
            timerProgressBar: true
        });
    </script>
}

@if (!string.IsNullOrEmpty(Convert.ToString(TempData[SweetAlert.Warning])))
