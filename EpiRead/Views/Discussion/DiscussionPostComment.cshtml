@model DiscussionPostVm

<div class="discussion-container mx-auto mt-4" style="max-width: 900px; padding-bottom: 120px;">
    <!-- Back to Discussion Page Button -->
    <div class="mb-3">
        <form asp-controller="Discussion" asp-action="Index" method="get" class="d-inline-block">
            <input type="hidden" name="bookId" value="@Model.Post.Discussion.BookId" />
            <button type="submit" class="btn btn-outline-info rounded-pill px-4 py-2 fw-semibold shadow-sm">
                <i class="fas fa-arrow-left me-2"></i> Back to Discussion
            </button>
        </form>
    </div>

    <!-- Main Discussion Post -->
    <div class="discussion-main-card p-4 rounded-4 shadow-sm mb-4">
        <div class="d-flex align-items-center mb-3">
            @if (!string.IsNullOrEmpty(Model.Post.User?.ProfileImageLink))
            {
                <img src="@Model.Post.User.ProfileImageLink" alt="User" class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover;" loading="lazy">
            }
            else
            {
                <div class="avatar-circle bg-info text-dark fw-bold me-3"
                     style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                    @Model.Post.User?.UserName?[0].ToString().ToUpper()
                </div>
            }

            <div>
                @{ var postDisplayName = Model.Post.User?.UserName ?? "Unknown";
                   if (string.Equals(Model.Post.User?.Role, "Author", System.StringComparison.OrdinalIgnoreCase)) postDisplayName += " (author)";
                }
                <h6 class="fw-semibold text-light mb-0">@postDisplayName</h6>
                <small class="text-secondary">@Model.Post.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
            </div>
        </div>

        <h5 class="fw-bold text-light">@Model.Post.Title</h5>
        <div class="comment-content text-white ps-1 mb-2">
            @Html.Raw(HtmlSanitizerHelper.SanitizeAndFormat(Model?.Post.Content ?? string.Empty))
        </div>

        <div class="d-flex justify-content-end align-items-center" id="updatePost-ajax">
            <partial name="_LikeButton" model="@Model" />
        </div>
        <button class="btn btn-outline-info btn-sm rounded-pill open-reply-modal" data-bs-toggle="modal" data-bs-target="#replyModal" data-comment-id="">
            <i class="fas fa-reply"></i> Reply
        </button>
    </div>

    <!-- Comments Section -->
    <h6 class="text-light mb-3"><i class="fas fa-comments me-2"></i>Comments</h6>
    <div class="discussion-comments" id="discussion-posts-container">
        @if (Model.Comments != null && Model.Comments.Any())
        {
            @foreach (var comment in Model.Comments)
            {
                <div class="comment-card mb-3 p-3 rounded-4 shadow-sm">
                    <!-- Comment header -->
                    <div class="d-flex align-items-center mb-2">
                        @if (!string.IsNullOrEmpty(comment.User?.ProfileImageLink))
                        {
                            <img src="@comment.User.ProfileImageLink" class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;" loading="lazy">
                        }
                        else
                        {
                            <div class="avatar-circle bg-info text-dark fw-bold me-3"
                                 style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                                @comment.User?.UserName?[0].ToString().ToUpper()
                            </div>
                        }

                        <div>
                            @{ var commentDisplayName = comment.User?.UserName ?? "Unknown";
                           if (string.Equals(comment.User?.Role, "Author", System.StringComparison.OrdinalIgnoreCase)) commentDisplayName += " (author)";
                        }
                        <strong class="text-info">@commentDisplayName</strong>
                            <small class="text-secondary ms-2">@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                        </div>
                    </div>

                    <!-- Comment content -->
                    <div class="comment-content text-white ps-1 mb-2">
                        @Html.Raw(comment.Content)
                    </div>

                    <div class="d-flex justify-content-end">
                        <div class="d-flex align-items-center gap-3" id="updateCommentLike-ajax-@comment.Id">
                            <partial name="Comment/_LikeButtonForComment" model="comment" />
                            <!-- Other comment actions/buttons here -->
                        </div>
                        <button class="btn btn-outline-info btn-sm rounded-pill open-reply-modal" data-bs-toggle="modal" data-bs-target="#replyModal" data-comment-id="@comment.Id">
                            <i class="fas fa-reply"></i> Reply
                        </button>
                    </div>

                    <!-- Replies -->
                    <partial name="Comment/_ReplyComment" model="comment" />
                </div>
            }
        }
        else
        {
            <div class="text-center text-secondary py-5">
                <i class="fas fa-comment-dots fa-2x mb-2 text-info"></i>
                <p>No comments yet. Be the first to share your thoughts!</p>
            </div>
        }
    </div>

</div>

<!-- Reply Modal -->
<div class="modal fade" id="replyModal" tabindex="-1" aria-labelledby="replyModalLabel" aria-hidden="true">
    <partial name="Comment/_AddComment" model="@Model" />
</div>


<style>
    body {
        background-color: #1E1F25;
    }

    .discussion-main-card {
        background: linear-gradient(145deg, #2B2E36, #23252B);
        border: 1px solid rgba(108, 99, 255, 0.15);
    }

    .comment-card {
        background: #23252B;
        border: 1px solid rgba(108, 99, 255, 0.15);
        transition: all 0.2s ease;
    }

        .comment-card:hover {
            border-color: rgba(108, 99, 255, 0.4);
            box-shadow: 0 0 10px rgba(108, 99, 255, 0.15);
        }

    .reply-content img {
        width: 200px;
        height: 160px;
        object-fit: cover;
        border-radius: 8px;
        margin-top: 8px;
    }



    .btn-outline-info:hover {
        background-color: #6c63ff;
        color: #fff;
    }

    .comment-content img {
        width: 250px;
        height: 200px;
        object-fit: cover; /* keeps proportions without distortion */
        border-radius: 8px;
        margin: 10px 0;
    }

    .btn-like {
        background: transparent;
        color: #bbb;
        transition: all 0.2s ease;
    }

        .btn-like:hover {
            color: #ff4b5c;
        }

        .btn-like.liked {
            color: #ff4b5c;
            transform: scale(1.2);
        }

</style>

@section Scripts {
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

    <script>
        let quill;

        document.addEventListener("DOMContentLoaded", function () {
                   quill = new Quill('#editor', {
            theme: 'snow',
            placeholder: 'Write something...',
            modules: {
                toolbar: [
                    ['bold', 'italic', 'underline', 'strike'],        // text styles
                   [{ 'header': [1, 2, 3, false] }],               // headers
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'image'],                                // ✅ add image button
                    ['clean']                                         // remove formatting
                ]
            }
        });

            // Get modal element
            const replyModal = document.getElementById('replyModal');

            // ✅ 1. When "Reply" button clicked, pass commentId to hidden input
            document.querySelectorAll('.open-reply-modal').forEach(btn => {
                btn.addEventListener('click', function () {
                    const commentId = this.getAttribute('data-comment-id');
                    document.getElementById('replyParentId').value = commentId;
                });
            });

            // ✅ 2. Clear editor and reset hidden inputs when modal closed
            if (replyModal) {
                replyModal.addEventListener('hidden.bs.modal', function () {
                    quill.setText('');
                    document.getElementById("contentInput").value = '';
                    document.getElementById("replyParentId").value = '';
                });
            }
        });

        // ✅ 3. Before submitting, put Quill HTML into hidden field
        document.addEventListener('submit', function (e) {
            if (e.target && e.target.id === 'commentForm') {
                const html = quill.root.innerHTML.trim();
                document.getElementById("contentInput").value = html;
            }
        });

        //toggle toolbar onpageshow more reply
        document.addEventListener("click", function (e) {
            if (e.target.classList.contains("toggle-replies")) {
                const targetId = e.target.getAttribute("data-target");
                const replies = document.getElementById(targetId);

                if (replies) {
                    replies.classList.toggle("d-none");
                    e.target.textContent = replies.classList.contains("d-none")
                        ? `👇 See ${replies.children.length} repl${replies.children.length > 1 ? "ies" : "y"}`
                        : "👆 Hide replies";
                }
            }
        });

        $(document).on("click", ".btn-like", function () {
            const btn = $(this);
            const postId = btn.data("post-id");
            const countElem = btn.find(".like-count");
            let count = parseInt(countElem.text());

            const isLiked = btn.hasClass("liked");

            if (isLiked) {
                btn.removeClass("liked");
                count--;
            } else {
                btn.addClass("liked");
                count++;
            }

            countElem.text(count);
        });
    </script>
}


