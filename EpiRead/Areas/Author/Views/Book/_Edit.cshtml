@using EpiRead.ViewComponents
@model EpiRead.Areas.Author.ViewModels.EditBookVm

<partial name="_SweetAlert"/>
<partial name="_ActionEditForm" model="@Model"/>

<form data-ajax="true"
      data-ajax-update="#ajax-update-content"
      asp-action="Update"
      method="post"
      enctype="multipart/form-data"
      class="animate__animated animate__fadeInUp">

    <input type="hidden" asp-for="Id"/>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-4">
        <!-- Left: main inputs (use create layout) -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Book details</h5>

                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Enter book title"/>
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Author</label>
                        <input asp-for="AuthorName" class="form-control" placeholder="Author full name"/>
                        <span asp-validation-for="AuthorName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>

                        <!-- wrapper only for textarea + AI button so absolute positioning refers to the textarea area -->
                        <div class="position-relative">
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Short summary to attract readers..." style="padding-right: 56px;"></textarea>

                            <button type="button" class="btn btn-sm btn-outline-primary position-absolute"
                                    id="ai-generate-description-btn"
                                    title="Generate description using AI"
                                    aria-label="Generate description using AI"
                                    style="right: 10px; top: 8px; z-index: 10;">
                                <i class="fas fa-magic"></i>
                            </button>
                        </div>

                        <small class="text-muted">Tip: keep it under 500 words for better readability.</small>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Publication Year</label>
                            <select asp-for="PublicationYear" asp-items="@GetYearList(Common.MinPublicationYear, Common.MaxPublicationYear, true)" class="form-control" id="PublicationYear" aria-label="Publication Year">
                                <option value="">Select year</option>
                            </select>
                            <span asp-validation-for="PublicationYear" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Language</label>
                            <select asp-for="Language" class="form-select" aria-label="Select language">
                                @if (ViewBag.Languages is SelectList languages)
                                {
                                    foreach (SelectListItem item in languages)
                                    {
                                        <option value="@item.Value" selected="@(item.Value == Model.Language)">@item.Text</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Language" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Categories</label>
                        <div class="border rounded p-2" style="background: #fafafa; max-height: 260px; overflow: auto;">
                            <div class="row g-2">
                                @{
                                    // Render categories using the existing checkbox partial (Author-scoped)
                                    List<int> selectedIds = Model != null && Model.CategoryIds != null ? Model.CategoryIds : new List<int>();
                                    var checkboxModel = new CheckboxListVm<BookCategory, int>
                                    {
                                        Items = ViewBag.BookCategories as List<BookCategory> ?? new List<BookCategory>(),
                                        SelectedValues = selectedIds,
                                        Name = "CategoryIds",
                                        ValueProperty = "Id",
                                        TextProperty = "Name"
                                    };
                                }
                                <partial name="_CheckboxList" model="checkboxModel"/>
                            </div>
                        </div>
                        <small id="selectedCategoriesCount" class="text-muted">@(Model.CategoryIds?.Count ?? 0) selected</small>
                        <span asp-validation-for="CategoryIds" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: cover preview + actions -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body d-flex flex-column align-items-center">
                    <h5 class="card-title">Cover & actions</h5>

                    <div class="w-100 mb-3 text-center">
                        <div id="coverPreviewWrapper" class="border rounded p-2" style="background: #fff;">
                            <img id="coverPreview" src="@(string.IsNullOrEmpty(Model.CoverImageLink) ? "/images/book-cover-not-available.webp" : Model.CoverImageLink)" alt="Cover preview" class="img-fluid" style="display: block; margin: auto; max-height: 320px;"/>
                        </div>
                        <small class="d-block text-muted mt-2">Recommended: 600x900px, JPG/PNG</small>
                    </div>

                    <div class="w-100 mb-3">
                        <label class="form-label">Upload Cover</label>
                        <input id="CoverImageInput" type="file" name="CoverImage" class="form-control" accept="image/*" aria-describedby="coverHelp"/>
                        <div id="coverHelp" class="form-text">You can drag & drop an image or click to browse.</div>
                        <span asp-validation-for="CoverImage" class="text-danger"></span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CoverImagePath))
                    {
                        <div class="w-100 mb-3">
                            <button class="btn btn-danger w-100"
                                    data-confirm="Are you sure to remove the cover image?"
                                    form="removeCoverImageForm">
                                <i class="fas fa-image" aria-hidden="true"></i> Remove Cover Image
                            </button>
                        </div>
                    }

                    <div class="w-100 mb-3">
                        <button type="submit" class="btn btn-primary w-100" data-confirm="Are you sure to save the changes?">Save Changes</button>
                    </div>

                    <a asp-area="Author" asp-controller="Book" asp-action="Show" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100">Back to my books</a>
                </div>
            </div>
        </div>
    </div>

</form>

<script>
    (function() {
        // Cover image preview
        const input = document.getElementById('CoverImageInput');
        const preview = document.getElementById('coverPreview');

        function readImage(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        if (input) {
            input.addEventListener('change',
                function(e) {
                    if (e.target.files && e.target.files[0]) {
                        readImage(e.target.files[0]);
                    }
                });

            // Basic drag & drop support
            const wrapper = document.getElementById('coverPreviewWrapper');
            if (wrapper) {
                wrapper.addEventListener('dragover',
                    function(ev) {
                        ev.preventDefault();
                        wrapper.classList.add('border-primary');
                    });
                wrapper.addEventListener('dragleave',
                    function(ev) {
                        ev.preventDefault();
                        wrapper.classList.remove('border-primary');
                    });
                wrapper.addEventListener('drop',
                    function(ev) {
                        ev.preventDefault();
                        wrapper.classList.remove('border-primary');
                        if (ev.dataTransfer && ev.dataTransfer.files && ev.dataTransfer.files[0]) {
                            input.files = ev.dataTransfer.files;
                            readImage(ev.dataTransfer.files[0]);
                        }
                    });
            }
        }

        // Update selected categories count
        function updateCategoryCount() {
            const checks = document.querySelectorAll('input[name="CategoryIds"]:checked');
            const el = document.getElementById('selectedCategoriesCount');
            if (el) el.textContent = checks.length + ' selected';
        }

        document.addEventListener('change',
            function(e) {
                if (e.target && e.target.name === 'CategoryIds') updateCategoryCount();
            });

        // Initialize count on load
        updateCategoryCount();
    })();
</script>