@model BookCategoryImportSummaryVm

<div id="summarySection" class="mt-4">
    <h5><i class="fas fa-list-alt"></i> Import Summary</h5>
    <table class="table table-bordered">
        <tbody>
        <tr>
            <th>Categories Added</th>
            <td>@Model.Added</td>
        </tr>
        <tr>
            <th>Categories Updated</th>
            <td>@Model.Updated</td>
        </tr>
        <tr>
            <th>Categories Skipped</th>
            <td>@Model.Skipped</td>
        </tr>
        <tr>
            <th>Unresolved</th>
            <td>@Model.Unresolved</td>
        </tr>
        </tbody>
    </table>
    @if (Model.Unresolved > 0)
    {
        <div class="alert alert-warning" role="alert">
            <i class="fas fa-exclamation-triangle"></i> Some items could not be imported. Please review the unresolved items.
        </div>
    }
    else
    {
        <div class="alert alert-success" role="alert">
            <i class="fas fa-check-circle"></i> Book category import completed successfully.
        </div>
    }
    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-area="Admin" asp-controller="BookCategory" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-list" aria-hidden="true"></i> View Categories
        </a>
    </div>
</div>