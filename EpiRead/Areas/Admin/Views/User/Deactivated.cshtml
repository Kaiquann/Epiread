@model IPagedList<User>

@{
    ViewBag.Title = "Manage Deactivated Users";
}

<section>
    <div class="container my-5">
        <h2 class="text-center mb-4">@ViewBag.Title</h2>

        <div class="d-flex justify-content-start align-items-center mb-3 gap-1">
            <a asp-controller="User" asp-action="Index" class="btn btn-secondary d-flex align-items-center">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Go Back
            </a>
        </div>

        <div class="d-flex justify-content-start align-items-center mb-3 gap-1">
            <i class="fas fa-tasks" aria-hidden="true"></i> <b>Bulk Actions</b>
            <button type="button"
                    data-ajax="true"
                    data-ajax-update="#table-ajax"
                    data-message="Are you sure to reactivate all the selected users?"
                    data-action="/Admin/User/Reactivate"
                    class="select-submit-btn btn btn-warning"
                    form="select-form">
                <i class="fas fa-undo" aria-hidden="true"></i> Reactivate
            </button>
            <button type="button"
                    data-ajax="true"
                    data-ajax-update="#table-ajax"
                    data-message="Are you sure to permanently delete all the selected users?"
                    data-action="/Admin/User/PermanentlyDelete"
                    class="select-submit-btn btn btn-danger"
                    form="select-form">
                <i class="fas fa-times" aria-hidden="true"></i> Permanently Delete
            </button>
        </div>

        <partial name="_FilterBar"/>

        <div id="table-ajax">
            <partial name="_Index"/>
        </div>
    </div>
</section>