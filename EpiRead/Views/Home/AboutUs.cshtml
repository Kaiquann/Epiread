@{
    ViewBag.Title = "About Us";
}

<style>
    :root {
        --epiread-bg: #383D48;
        --epiread-card: #23262F;
        --epiread-primary: #6c63ff;
        --epiread-secondary: #2F333B;
        --epiread-text: #e0e0e0;
        --epiread-muted: #b0b0b0;
    }

    body { background-color: var(--epiread-bg); }

    .bg-dark,
    .card.bg-secondary,
    .bg-secondary,
    .rounded-4 {
        background-color: var(--epiread-card) !important;
        color: var(--epiread-text) !important;
    }

    .text-primary { color: var(--epiread-primary) !important; }

    .text-light { color: var(--epiread-text) !important; }

    .text-muted { color: var(--epiread-muted) !important; }

    .card {
        border: none;
        box-shadow: 0 4px 24px rgba(108, 99, 255, 0.10);
    }

    .fw-bold { font-weight: 700 !important; }

    .display-4 { color: #fff; }

    .lead { color: #ccc; }
</style>

<div class="container-fluid bg-dark text-light py-5" style="background: linear-gradient(135deg, #546063, #5e4ab1);">
    <div class="container text-center py-4">
        <h1 class="display-4 fw-bold mb-2">About Us</h1>
        <p class="lead mb-0">Your gateway to smarter, more enjoyable reading.</p>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4 justify-content-center">
        <div class="col-md-4">
            <div class="card bg-secondary h-100 shadow-sm text-center p-4">
                <h4 class="text-primary fw-bold">AI-Powered Discovery</h4>
                <p class="mb-0">Find your next favorite book with our smart, semantic search and personalized recommendations.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-secondary h-100 shadow-sm text-center p-4">
                <h4 class="text-primary fw-bold">Track & Connect</h4>
                <p class="mb-0">Monitor your reading progress, set goals, and join a vibrant community of book lovers.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-secondary h-100 shadow-sm text-center p-4">
                <h4 class="text-primary fw-bold">Modern Experience</h4>
                <p class="mb-0">Enjoy a beautiful, user-friendly platform designed for seamless reading and sharing.</p>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row align-items-center g-4 bg-secondary rounded-4 shadow-sm p-4">
        <div class="col-lg-5 text-center">
            <img src="/images/AboutUs.webp" alt="Teamwork" class="img-fluid rounded-3 shadow" style="max-width: 320px;" loading="lazy">
        </div>
        <div class="col-lg-7">
            <h2 class="text-primary fw-bold mb-3">Society Where There is Understanding</h2>
            <p class="fs-5 mb-0">EpiRead is dedicated to transforming the way you discover, read, and connect with books. Our platform leverages AI-powered recommendations, personalized reading progress, and a vibrant community to help you find your next favorite book and share your journey with others.</p>
        </div>
    </div>
</div>

<div class="container my-5">
    <h2 class="text-primary fw-bold text-center mb-4">We Provide Solutions For Your Reading Journey</h2>
    <div class="row g-4 justify-content-center">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card bg-secondary text-center p-3 h-100">
                <i class="fas fa-search fa-2x text-primary mb-2"></i>
                <h6 class="fw-bold">Smart Search</h6>
                <p class="small mb-0">AI-driven semantic book search for fast, relevant results.</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card bg-secondary text-center p-3 h-100">
                <i class="fas fa-star fa-2x text-primary mb-2"></i>
                <h6 class="fw-bold">Personalized Recommendations</h6>
                <p class="small mb-0">Suggestions tailored to your reading habits and interests.</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card bg-secondary text-center p-3 h-100">
                <i class="fas fa-chart-line fa-2x text-primary mb-2"></i>
                <h6 class="fw-bold">Progress Tracking</h6>
                <p class="small mb-0">Track your reading, set goals, and celebrate milestones.</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card bg-secondary text-center p-3 h-100">
                <i class="fas fa-users fa-2x text-primary mb-2"></i>
                <h6 class="fw-bold">Community Forums</h6>
                <p class="small mb-0">Join discussions, share reviews, and connect with readers.</p>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card bg-secondary text-center p-3 h-100">
                <i class="fas fa-mobile-alt fa-2x text-primary mb-2"></i>
                <h6 class="fw-bold">Modern Design</h6>
                <p class="small mb-0">Enjoy a beautiful, responsive, and intuitive interface.</p>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4 justify-content-center text-center bg-secondary rounded-4 shadow-sm p-4">
        <div class="col-6 col-md-3">
            <i class="fas fa-users fa-2x text-primary mb-2"></i>
            <div class="fs-2 fw-bold text-primary">10,000+</div>
            <div class="text-light">Happy Readers</div>
        </div>
        <div class="col-6 col-md-3">
            <i class="fas fa-smile-beam fa-2x text-primary mb-2"></i>
            <div class="fs-2 fw-bold text-primary">99%</div>
            <div class="text-light">User Satisfaction</div>
        </div>
        <div class="col-6 col-md-3">
            <i class="fas fa-book-open fa-2x text-primary mb-2"></i>
            <div class="fs-2 fw-bold text-primary">5,000+</div>
            <div class="text-light">Books Tracked</div>
        </div>
        <div class="col-6 col-md-3">
            <i class="fas fa-comments fa-2x text-primary mb-2"></i>
            <div class="fs-2 fw-bold text-primary">1,200+</div>
            <div class="text-light">Active Discussions</div>
        </div>
    </div>
</div>