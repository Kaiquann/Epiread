@model IPagedList<Book>
@{
    ViewBag.Title = "Export Books";
}

<section>
    <div class="container my-5">
        <h2 class="text-center mb-4">@ViewBag.Title</h2>

        <div class="d-flex justify-content-between align-items-center mb-3 gap-1">
            <a asp-area="Admin" asp-controller="Book" asp-action="Index" class="btn btn-secondary d-flex align-items-center">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Go Back
            </a>
            <div class="d-flex gap-2 align-items-center">
                <select name="exportType" form="select-form" class="form-select form-select-sm" style="width: 150px;">
                    <option value="metadata">Metadata only</option>
                    <option value="full">Full Backup</option>
                </select>

                <button type="button"
                        data-message="Are you sure to export the books as ZIP?"
                        data-action="/Admin/Book/ExportZip"
                        class="select-submit-btn btn btn-primary"
                        form="select-form">
                    <i class="fa fa-download"></i> Export as ZIP
                </button>
            </div>
        </div>

        <div id="table-ajax">
            <partial name="_Export"/>
        </div>
    </div>
</section>