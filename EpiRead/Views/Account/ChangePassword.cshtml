@model ChangePasswordVm;
@{
    ViewBag.Title = "Change your password";
}

<section>
    <div class="container my-5 profile-bg" style="max-width: 540px; min-height: 70vh;">
        <form asp-action="ChangePassword" method="post" class="change-password-form">
            <h1 class="mb-4 fw-bold" style="font-size: 2.1rem; letter-spacing: -1px;">@ViewBag.Title</h1>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-4">
                <label asp-for="OldPassword" class="form-label field-label"></label>
                <input asp-for="OldPassword" class="form-control field-input" autocomplete="current-password"/>
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="NewPassword" class="form-label field-label"></label>
                <input asp-for="NewPassword" class="form-control field-input" autocomplete="new-password"/>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-5">
                <label asp-for="ConfirmNewPassword" class="form-label field-label"></label>
                <input asp-for="ConfirmNewPassword" class="form-control field-input" autocomplete="new-password"/>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-4 gap-2">
                <a asp-controller="Account" asp-action="Profile" class="btn btn-link cancel-link px-0 fw-semibold">CANCEL</a>
                <button type="submit" class="btn btn-success set-password-btn px-4 py-2 fw-semibold">SET NEW PASSWORD</button>
            </div>
        </form>
    </div>
</section>

<style>
    body, .profile-bg { background: #23262F !important; }

    .change-password-form {
        background: transparent;
        border-radius: 0;
        box-shadow: none;
        padding: 0;
    }

    .change-password-form h1 {
        color: #fff;
        font-weight: 700;
        text-align: left;
    }

    .field-label {
        color: #b0b0b0;
        font-size: 1rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        margin-bottom: 0.3rem;
    }

    .field-input {
        background: transparent;
        border: none;
        border-bottom: 2px solid #444a57;
        border-radius: 0;
        box-shadow: none;
        color: #fff;
        font-size: 1.1rem;
        outline: none;
        padding-left: 0;
        padding-right: 0;
    }

    .field-input:focus {
        background: transparent;
        border-bottom: 2px solid #4be37a;
        box-shadow: none;
        color: #fff;
    }

    .set-password-btn {
        background: #1ed760;
        border: none;
        border-radius: 24px;
        color: #23262F;
        font-size: 1.08rem;
        letter-spacing: 0.04em;
        min-width: 210px;
        transition: background 0.2s, color 0.2s;
    }

    .set-password-btn:hover, .set-password-btn:focus {
        background: #1db954;
        color: #fff;
    }

    .cancel-link {
        border-radius: 24px;
        color: #b0b0b0;
        font-size: 1.08rem;
        text-decoration: none;
        transition: color 0.2s;
    }

    .cancel-link:hover, .cancel-link:focus {
        color: #fff;
        text-decoration: underline;
    }
</style>