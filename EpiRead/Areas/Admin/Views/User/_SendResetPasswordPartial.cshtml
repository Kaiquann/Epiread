@model dynamic
@{
    // Model should have Id and Role properties. Accepts both User and EditUserVm
    string targetId = Model?.Id?.ToString() ?? "";
    string targetRole = Model?.Role ?? "";

    string currentUserId = User.Identity?.Name ?? "";
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    bool isAdmin = User.IsInRole("Admin");
    bool isSelf = currentUserId == targetId;

    bool isTargetAllowedForAdmin = targetRole == nameof(UserRoleType.Author) ||
                                   targetRole == nameof(UserRoleType.Member);

    bool canSendReset = !isSelf && (isSuperAdmin || (isAdmin && isTargetAllowedForAdmin));
}

@if (canSendReset)
{
    <button data-confirm="Are you sure to send reset password link to this user?"
            class="btn btn-danger"
            form="sendResetPasswordForm">
        <i class="fas fa-envelope" aria-hidden="true"></i> Send Reset Password Link
    </button>
}