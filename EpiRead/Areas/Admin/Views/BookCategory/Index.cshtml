@model IPagedList<BookCategoryTreeItemVm>
@{
    ViewBag.Title = "Manage Book Category";
}

<section>
    <div class="container my-5">
        <h2 class="text-center mb-4">@ViewBag.Title</h2>

        <div class="d-flex justify-content-start align-items-center mb-3 gap-1">
            <a asp-controller="BookCategory" asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus" aria-hidden="true"></i> Create
            </a>
            <a asp-controller="BookCategory" asp-action="Import" class="btn btn-success" title="Import book categories via ZIP">
                <i class="fas fa-file-import" aria-hidden="true"></i> Import
            </a>
            <a asp-controller="BookCategory" asp-action="Export" class="btn btn-info" title="Export book categories as ZIP">
                <i class="fas fa-file-download" aria-hidden="true"></i> Export as ZIP
            </a>
        </div>

        <div class="d-flex justify-content-start align-items-center mb-3 gap-1">
            <i class="fas fa-tasks" aria-hidden="true"></i> <b>Bulk Actions</b>
            <button type="button"
                    data-ajax="true"
                    data-ajax-update="#table-ajax"
                    data-message="Are you sure to delete all the selected book category?"
                    data-action="/Admin/BookCategory/Delete"
                    class="select-submit-btn btn btn-danger"
                    form="select-form">
                <i class="fas fa-trash" aria-hidden="true"></i> Delete
            </button>
        </div>

        <div id="table-ajax">
            <partial name="_Index"/>
        </div>
    </div>
</section>