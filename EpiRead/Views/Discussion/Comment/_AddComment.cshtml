@model DiscussionPostVm

<div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content bg-dark text-light rounded-4 border-0 shadow-lg">
        <div class="modal-header border-secondary">
            <h5 class="modal-title text-info fw-bold" id="replyModalLabel">
                <i class="fas fa-reply me-2"></i> Write a Comment
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form asp-controller="Discussion" asp-action="AddComment" method="post" id="commentForm">
                <input name="PostId" type="hidden" value="@Model.Post.Id" />
                <input asp-for="ParentCommentId" type="hidden" id="replyParentId" value="" />

                <div class="mb-3">
                    <label class="form-label text-info fw-semibold">Content</label>
                    <!-- Rich text editor -->
                    <div id="editor" class="bg-secondary text-light rounded-3 p-2" style="min-height:150px;"></div>
                    <!-- Hidden input (name must match controller parameter) -->
                    <input type="hidden" id="contentInput" name="content" />
                </div>

                <div class="text-end">
                    <button type="button" class="btn btn-outline-light fw-semibold rounded-pill px-4 me-2" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info text-white fw-semibold rounded-pill px-4">
                        <i class="fas fa-paper-plane me-1"></i> Post
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
        document.addEventListener('submit', function (e) {
        if (e.target && e.target.id === 'createPostForm') {

            const html = quill.root.innerHTML.trim();
            const text = quill.getText().trim(); // plain text version

            if (text.length === 0) {
                e.preventDefault(); // stop submit
                alert("Content is required.");
                return;
            }

            document.getElementById("contentInput").value = html;
        }
    });

</script>


