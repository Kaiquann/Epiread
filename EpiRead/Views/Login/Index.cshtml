@model LoginVm;
@inject ICfCaptchaHelper CfCaptchaHelper
@{
    ViewBag.Title = "Login";
}

<section>
    <div class="container-fluid login-bg d-flex align-items-center justify-content-center min-vh-100">
        <div class="login-card row w-100 align-items-stretch shadow-lg overflow-hidden" style="border-radius: 24px; max-width: 900px; min-height: 520px;">
            <!-- Left: Welcome/Brand -->
            <div class="col-md-6 d-none d-md-flex flex-column justify-content-center align-items-center login-left px-4 py-5">
                <div class="mb-4">
                    <img src="/images/logo_transparent.webp" alt="Logo" loading="lazy" style="background: #292c36; border-radius: 50%; height: 96px; width: 96px;"/>
                </div>
                <h1 class="fw-bold mb-3" style="color: #fff; font-size: 2.2rem;">Hello, welcome!</h1>
                <p class="mb-0" style="color: #b0b0b0; font-size: 1.08rem; max-width: 320px;">Welcome back to EpiRead. Please login to continue your reading journey.</p>
            </div>
            <!-- Right: Login Form -->
            <div class="col-md-6 bg-dark d-flex flex-column justify-content-center align-items-center px-4 py-5">
                <div class="w-100" style="max-width: 340px;">
                    <h2 class="fw-bold mb-4 text-center" style="color: #fff;">Login</h2>
                    <form asp-action="Index" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/>
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label login-label"></label>
                            <input asp-for="Email" class="form-control login-input"/>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label login-label"></label>
                            <input asp-for="Password" class="form-control login-input"/>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck"/>
                                <label asp-for="RememberMe" class="form-check-label login-label" for="rememberMeCheck"></label>
                            </div>
                            <div>
                                <a asp-controller="ForgotPassword" asp-action="Index" class="login-link">Forgot password?</a>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success login-btn w-100 mb-2" data-confirm>Login</button>
                        <button type="button" class="btn btn-outline-light login-btn w-100 mb-3" onclick="window.location.href = '@Url.Action("Index", "Register")'">Sign up</button>
                        <div class="text-center mt-2">
                            <a asp-controller="RecoveryMfa" asp-action="Index" class="login-link"><i class="fas fa-key me-1"></i> Recovery MFA?</a>
                        </div>
                        @CfCaptchaHelper.GetCaptchaHtml()
                    </form>
                    <div class="text-center mt-4">
                        <span class="login-label">Follow</span>
                        <a href="#" class="login-social ms-2">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="login-social ms-2">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="login-social ms-2">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    body { margin-bottom: 15px; }

    .login-bg {
        background: linear-gradient(120deg, #23262F 0%, #383D48 100%);
        min-height: 100vh;
        overflow: hidden;
        position: relative;
    }

    .login-bg::before {
        background: radial-gradient(circle at 20% 30%, #6c63ff33 0%, transparent 60%),
                    radial-gradient(circle at 80% 70%, #4be37a22 0%, transparent 70%),
                    radial-gradient(circle at 60% 10%, #6c63ff22 0%, transparent 70%);
        bottom: 0;
        content: '';
        left: 0;
        position: absolute;
        right: 0;
        top: 0;
        z-index: 0;
    }

    .login-card {
        background: transparent;
        border-radius: 24px;
        box-shadow: 0 4px 32px 0 rgba(44, 48, 60, 0.18);
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    .login-left {
        align-items: flex-start;
        background: linear-gradient(135deg, #6c63ff 0%, #23262F 100%);
        border-bottom-left-radius: 24px;
        border-top-left-radius: 24px;
        color: #fff;
        justify-content: center;
        min-height: 520px;
        overflow: hidden;
        position: relative;
        text-align: left;
        z-index: 2;
    }

    .login-label {
        color: #b0b0b0;
        font-size: 1rem;
        font-weight: 500;
    }

    .login-input {
        background: transparent;
        border: 2px solid #6c63ff;
        border-radius: 8px;
        box-shadow: none;
        color: #fff;
        font-size: 1.08rem;
        outline: none;
        padding: 0.7rem 1rem;
        transition: border 0.2s;
    }

    .login-input:focus {
        background: transparent;
        border: 2px solid #4be37a;
        box-shadow: none;
        color: #fff;
    }

    .login-link {
        color: #6c63ff;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
    }

    .login-link:hover, .login-link:focus {
        color: #4be37a;
        text-decoration: underline;
    }

    .login-btn {
        border-radius: 24px;
        box-shadow: none;
        font-size: 1.08rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        padding: 0.7rem 0;
    }

    .btn-success.login-btn {
        background: #4be37a;
        border: none;
        color: #23262F;
    }

    .btn-success.login-btn:hover, .btn-success.login-btn:focus {
        background: #38c96a;
        color: #fff;
    }

    .btn-outline-light.login-btn {
        background: transparent;
        border: 2px solid #6c63ff;
        color: #6c63ff;
    }

    .btn-outline-light.login-btn:hover, .btn-outline-light.login-btn:focus {
        background: #6c63ff;
        color: #fff;
    }

    .login-social {
        color: #b0b0b0;
        font-size: 1.3rem;
        margin: 0 0.2rem;
        transition: color 0.2s;
    }

    .login-social:hover, .login-social:focus { color: #6c63ff; }

</style>