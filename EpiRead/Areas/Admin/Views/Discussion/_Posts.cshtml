@model IPagedList<DiscussionPost>

<partial name="_SweetAlert"/>

<style>
    /* Light theme variant */
    .admin-posts-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr;
    }

    @@media (min-width: 900px) {
        .admin-posts-grid { grid-template-columns: 1fr; }
    }

    .post-card {
        align-items: flex-start;
        background: #fff;
        border: 1px solid #e6e6e6;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(16, 24, 40, 0.06);
        display: flex;
        gap: 12px;
        padding: 14px;
        transition: transform .12s ease, box-shadow .12s ease;
    }

    .post-card:hover {
        box-shadow: 0 10px 26px rgba(16, 24, 40, 0.08);
        transform: translateY(-4px);
    }

    .post-avatar {
        border: 2px solid #f1f3f5;
        border-radius: 50%;
        flex: 0 0 56px;
        height: 56px;
        object-fit: cover;
        width: 56px;
    }

    .post-body {
        flex: 1 1 auto;
        min-width: 0;
    }

    .post-title {
        color: #212529;
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0 0 6px 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .post-excerpt {
        color: #495057;
        font-size: 0.95rem;
        margin: 0 0 8px 0;
        max-height: 3.6rem;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .post-meta {
        align-items: center;
        color: #6c757d;
        display: flex;
        font-size: 0.9rem;
        gap: 10px;
    }

    .meta-badge {
        align-items: center;
        background: #f1f3f5;
        border-radius: 999px;
        color: #343a40;
        display: inline-flex;
        font-size: 0.82rem;
        gap: 6px;
        padding: 4px 8px;
    }

    .post-actions {
        align-items: center;
        display: flex;
        gap: 8px;
    }

    .action-btn {
        background: transparent;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        color: #343a40;
        cursor: pointer;
        padding: 8px 10px;
    }

    .action-btn:focus { outline: 3px solid rgba(108, 99, 255, 0.12); }

    .post-time {
        color: #6c757d;
        font-size: 0.85rem;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 text-light-emphasis">Posts</h4>
    <div class="text-muted">@((Model?.TotalItemCount).GetValueOrDefault(0)) posts</div>
</div>

<div class="admin-posts-grid">
    @if (Model == null || !Model.Any())
    {
        @await Html.PartialAsync("_NoPosts")
    }
    else
    {
        foreach (var post in Model)
        {
            var topLevelComments = post.DiscussionComments?.Count(c => c.ReplyCommentId == null) ?? 0;
            var excerpt = post.Content.Length > 180 ? post.Content.Substring(0, 180) + "..." : post.Content;
            // Sanitize excerpt and preserve simple line breaks
            var safeExcerpt = HtmlSanitizerHelper.SanitizeAndFormat(excerpt ?? string.Empty);
            <div class="post-card" role="article" aria-labelledby="post-title-@post.Id">
                <img class="post-avatar" src="@(!string.IsNullOrEmpty(post.User?.ProfileImageLink) ? post.User.ProfileImageLink : !string.IsNullOrEmpty(post.User?.ProfileImagePath) ? "/uploads/" + post.User.ProfileImagePath : "/images/profile-icon.webp")" alt="@post.User?.UserName avatar"/>

                <div class="post-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div style="min-width: 0;">
                            <a asp-area="Admin" asp-controller="Discussion" asp-action="PostDetails" asp-route-id="@post.Id" class="text-decoration-none">
                                <h3 id="post-title-@post.Id" class="post-title">@post.Title</h3>
                            </a>
                            <p class="post-excerpt">@Html.Raw(safeExcerpt)</p>
                            @* Inline attachments (images) similar to client view but keeping a light theme *@
                            @if (post.DiscussionAttachments != null && post.DiscussionAttachments.Any())
                            {
                                var imageExts = new[] { ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg" };
                                <div class="mt-2">
                                    @foreach (var a in post.DiscussionAttachments)
                                    {
                                        var link = a.FileLink ?? a.FilePath;
                                        var isImage = !string.IsNullOrEmpty(link) && imageExts.Any(e => link!.ToLower().EndsWith(e));
                                        if (isImage)
                                        {
                                            <a href="@link" data-bs-toggle="modal" data-bs-target="#imagePreviewModal" data-img-src="@link" class="d-inline-block me-2 mb-2">
                                                <img src="@link" alt="attachment" class="img-fluid rounded mt-1 shadow-sm" style="background: #fff; max-height: 200px; object-fit: contain;"/>
                                            </a>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        <div class="post-actions ms-3">
                            <div class="post-time text-end">
                                @post.CreatedAt.ToString("yyyy-MM-dd")<br/><span class="post-time">@post.CreatedAt.ToString("t")</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div class="post-meta">
                            <span class="meta-badge">
                                <i class="fas fa-user"></i> @post.User?.UserName
                            </span>
                            <span class="meta-badge">
                                <i class="fas fa-comments"></i> @topLevelComments
                            </span>
                            <span class="meta-badge">
                                <i class="fas fa-eye"></i> @post.ViewCount
                            </span>
                        </div>

                        <div class="d-flex align-items-center">
                            <button class="action-btn" title="Ban post" aria-label="Ban post @post.Title" onclick="event.stopPropagation();event.preventDefault();" data-bs-toggle="modal" data-bs-target="#banModal-@post.Id">
                                <i class="fas fa-ban"></i>
                            </button>
                            <button class="action-btn" title="Trash post" aria-label="Trash post @post.Title" onclick="event.stopPropagation();event.preventDefault();" data-bs-toggle="modal" data-bs-target="#trashModal-@post.Id">
                                <i class="fas fa-trash"></i>
                            </button>
                            <a asp-area="Admin" asp-controller="Discussion" asp-action="PostDetails" asp-route-id="@post.Id" class="action-btn" title="Open post detail" aria-label="Open post @post.Title">
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @await Html.PartialAsync("_BanReason", post, new ViewDataDictionary(ViewData) { { "BanModalId", $"banModal-{post.Id}" } })
            @await Html.PartialAsync("_TrashPost", post, new ViewDataDictionary(ViewData) { { "TrashModalId", $"trashModal-{post.Id}" } })
        }
    }
</div>

@* Paging footer: reuse project's table footer if this partial is used for paged results. *@
@if (Model is { PageCount: > 1 })
{
    <div class="mt-3">@await Html.PartialAsync("Table/_FooterPartial", Model)</div>
}