@model EditUserVm
@{
    ViewBag.Title = "Editing User : " + Model.FirstName + " " + Model.LastName;
}

<section>
    <div class="container my-5">
        <h2 class="text-center mb-4">@ViewBag.Title</h2>
        <div class="card">
            <div class="card-body" id="ajax-update-content">
                <partial name="_Edit" model="@Model"/>
            </div>
        </div>
    </div>
</section>