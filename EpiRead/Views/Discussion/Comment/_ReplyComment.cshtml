@model DiscussionComment

<style>
    .btn-like {
        background: transparent;
        color: #bbb;
        transition: all 0.2s ease;
    }

        .btn-like:hover {
            color: #ff4b5c;
        }

        .btn-like.liked {
            color: #ff4b5c;
            transform: scale(1.2);
        }
</style>
@{
    // Define a color palette for distinguishing different parent threads
    var colorPalette = new[] { "border-info", "border-warning", "border-success", "border-danger", "border-primary", "border-secondary" };

    // Assign each parent comment a color based on its Id (so each thread is consistent)
    var threadColor = colorPalette[Model.Id % colorPalette.Length];
}

@if (Model.Replies != null && Model.Replies.Any())
{
    <div class="replies-section mt-3">
        <a href="javascript:void(0);"
           class="toggle-replies text-info text-decoration-none fw-semibold"
           data-target="replies-@Model.Id">
            👇 See @Model.Replies.Count reply@(Model.Replies.Count > 1 ? "ies" : "y")
        </a>

        <div id="replies-@Model.Id" class="replies-container mt-3 d-none">
            @foreach (var reply in Model.Replies)
            {
                <div class="reply-card mb-3 p-3 rounded-4 shadow-sm border-start border-4 @threadColor"
                     style="background-color: rgba(255,255,255,0.05);">

                    <!-- Header -->
                    <div class="d-flex align-items-center mb-2">
                        @if (!string.IsNullOrEmpty(reply.User?.ProfileImageLink))
                        {
                            <img src="@reply.User.ProfileImageLink" class="rounded-circle me-2" style="width: 35px; height: 35px; object-fit: cover;" loading="lazy">
                        }
                        else
                        {
                            <div class="avatar-circle bg-info text-dark fw-bold me-2"
                                 style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                                @reply.User?.UserName?[0].ToString().ToUpper()
                            </div>
                        }

                        <div>
                            @{ var replyDisplayName = reply.User?.UserName ?? "Unknown";
                               if (string.Equals(reply.User?.Role, "Author", System.StringComparison.OrdinalIgnoreCase)) replyDisplayName += " (author)";
                               var replyingToName = Model.User?.UserName ?? "Unknown";
                               if (string.Equals(Model.User?.Role, "Author", System.StringComparison.OrdinalIgnoreCase)) replyingToName += " (author)";
                            }
                            <strong class="text-info">@replyDisplayName</strong>
                            <div class="replying-to text-secondary mb-1" style="font-size: 0.85rem;">
                                <i class="fas fa-share fa-rotate-180 me-1 @threadColor.Replace("border-", "text-")"></i>
                                Replying to <span class="fw-semibold @threadColor.Replace("border-", "text-")">@replyingToName</span>
                            </div>
                            <small class="text-secondary ms-2">@reply.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="reply-content text-light ps-1 mb-2">
                        @Html.Raw(HtmlSanitizerHelper.SanitizeAndFormat(reply?.Content ?? string.Empty))
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3" id="updateCommentLike-ajax-@reply.Id">
                            <partial name="Comment/_LikeButtonForComment" model="reply" />
                        </div>

                        <button class="btn btn-outline-info btn-sm rounded-pill open-reply-modal"
                                data-bs-toggle="modal"
                                data-bs-target="#replyModal"
                                data-comment-id="@reply.Id">
                            <i class="fas fa-reply"></i> Reply
                        </button>
                    </div>
                </div>
                <!-- Recursive call (maintains same color) -->
                @await Html.PartialAsync("Comment/_ReplyComment", reply)
            }
        </div>
    </div>
}
