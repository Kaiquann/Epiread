@model EpiRead.ViewComponents.CheckboxListVm<BookCategory, int>

<style>
    .checkbox-list-scrollable {
        -ms-border-radius: 6px;
        background: #fafafa;
        border: 1px solid #ddd;
        border-radius: 6px;
        max-height: 220px;
        overflow-y: auto;
        padding: 8px;
    }

    .checkbox-list-grid {
        display: grid;
        gap: 8px 12px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    @@media (max-width: 768px) {
        .checkbox-list-grid { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
    }
</style>

<div class="checkbox-list-scrollable" role="group" aria-labelledby="checkbox-list-label">
    <div class="checkbox-list-grid">
        @foreach (BookCategory item in Model.Items)
        {
            string value = item.Id.ToString();
            string text = item.Name;
            bool isChecked = Model.SelectedValues != null && Model.SelectedValues.Any(v => v.ToString() == value);
            <div class="form-check">
                <input type="checkbox"
                       class="form-check-input"
                       id="@(Model.Name)_@value"
                       name="@Model.Name"
                       value="@value"
                       @(isChecked ? "checked" : null)
                       aria-labelledby="label_@(Model.Name)_@value"/>
                <label class="form-check-label" id="label_@(Model.Name)_@value" for="@(Model.Name)_@value">
                    @text
                </label>
            </div>
        }
    </div>
</div>