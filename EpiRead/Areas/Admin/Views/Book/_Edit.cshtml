@using EpiRead.ViewComponents
@model EditBookVm

<partial name="_SweetAlert"/>
<partial name="_ActionEditForm"/>

<form data-ajax="true"
      data-ajax-update="#ajax-update-content"
      asp-action="Update"
      asp-route-id="@Model.Id"
      method="post"
      enctype="multipart/form-data">
    <input type="hidden" asp-for="Id"/>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <table class="table table-bordered">
        <tbody>
        <tr>
            <td colspan="3">
                <label class="upload">
                    <input asp-for="CoverImage" accept="image/jpeg,image/png" hidden>
                    <partial name="Book/_CoverImagePartial" model="@Model.CoverImageLink"/>
                    <span></span>
                </label>
                <span asp-validation-for="CoverImage" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th>Title</th>
            <td>:</td>
            <td>
                <input asp-for="Title" class="form-control" data-trim/>
                <span asp-validation-for="Title" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th>Author</th>
            <td>:</td>
            <td>
                <input asp-for="AuthorName" class="form-control" data-trim/>
                <span asp-validation-for="AuthorName" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th>Description</th>
            <td>:</td>
            <td>
                <div class="position-relative">
                    <textarea asp-for="Description" class="form-control" data-trim></textarea>
                    <button type="button" class="btn btn-sm btn-outline-primary position-absolute"
                            id="ai-generate-description-btn"
                            title="Generate description using AI"
                            aria-label="Generate description using AI"
                            style="right: 5px; top: 5px; z-index: 10;">
                        <i class="fas fa-magic"></i>
                    </button>
                </div>
                <span asp-validation-for="Description" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th>Publication Year</th>
            <td>:</td>
            <td>
                <select asp-for="PublicationYear" asp-items="@GetYearList(Common.MinPublicationYear, Common.MaxPublicationYear, true)" class="form-control" id="PublicationYear" aria-label="Publication Year" required>
                    <option value="">Select year</option>
                </select>
                <span asp-validation-for="PublicationYear" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th>Language</th>
            <td>:</td>
            <td>
                <select asp-for="Language" asp-items="ViewBag.Languages" class="form-control" id="Language" aria-label="LanguageCodes" required>
                </select>
                <span asp-validation-for="Language" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <th>Categories</th>
            <td>:</td>
            <td>
                @{
                    List<int> selectedIds = Model != null && Model.CategoryIds != null ? Model.CategoryIds : new List<int>();
                    var checkboxModel = new CheckboxListVm<BookCategory, int>
                    {
                        Items = ViewBag.BookCategories,
                        SelectedValues = selectedIds,
                        Name = "CategoryIds",
                        ValueProperty = "Id",
                        TextProperty = "Name"
                    };
                }
                <partial name="_CheckboxList" model="checkboxModel"/>
                <span asp-validation-for="CategoryIds" class="text-danger"></span>
            </td>
        </tr>
        </tbody>
        <tfoot>
        <tr>
            <td colspan="3">
                <div class="d-flex justify-content-between align-items-center">
                    <!-- Left-aligned button -->
                    <div>
                        <a asp-area="Admin" asp-controller="Book" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left" aria-hidden="true"></i> Go Back
                        </a>
                    </div>

                    <!-- Center-aligned buttons -->
                    <div class="d-flex justify-content-center align-items-center gap-1 text-center">
                        <partial name="_ActionButtonEdit" model="@Model"/>

                        @if (Model != null && !string.IsNullOrEmpty(Model.CoverImagePath))
                        {
                            <button class="btn btn-danger"
                                    data-confirm="Are you sure to remove this book cover image?"
                                    form="removeCoverImageForm">
                                <i class="fas fa-image" aria-hidden="true"></i> Remove Cover Image
                            </button>
                        }
                    </div>

                    <!-- Right-aligned button -->
                    <div>
                        <button class="btn btn-success" data-confirm>
                            <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        </tfoot>
    </table>
</form>