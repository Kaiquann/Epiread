@model DiscussionPost
@{
    // single avatar computation
    var avatar = Model?.User?.ProfileImageLink;
    if (string.IsNullOrEmpty(avatar))
    {
        avatar = !string.IsNullOrEmpty(Model?.User?.ProfileImagePath) ? "/uploads/" + Model.User.ProfileImagePath : "/images/profile-icon.webp";
    }
}

<partial name="_SweetAlert"/>

<style>
    /* Light theme post detail styles */
    .post-detail-card {
        background: #fff;
        border: 1px solid #e6e6e6;
        color: #212529;
    }

    .post-detail-avatar {
        border: 2px solid #f1f3f5;
        border-radius: 12px;
        height: 72px;
        object-fit: cover;
        width: 72px;
    }

    .post-detail-preview {
        background: #fff;
        color: #212529;
    }
</style>

<div class="container mt-4">
    <button type="button" class="btn btn-outline-secondary rounded-circle mb-3 ms-1 shadow-sm" aria-label="Go back"
            onclick="history.back()">
        <i class="bi bi-arrow-left" aria-hidden="true" style="font-size: 1.5rem;"></i>
    </button>

    <div class="card mb-4 shadow-sm post-detail-card">
        <div class="card-body">
            <div class="d-flex gap-3 align-items-start">
                <img src="@avatar" alt="@(Model?.User?.UserName ?? "User") avatar" class="post-detail-avatar"/>
                <div style="flex: 1; min-width: 0;">
                    <h2 style="color: #212529; font-weight: 700; margin: 0;">@(Model?.Title ?? "")</h2>
                    <div class="d-flex align-items-center gap-3 mt-2">
                        <div style="color: #6c757d; font-size: 0.95rem;">
                            By
                            <strong style="color: #343a40">@(Model?.User?.UserName ?? "Unknown")</strong>
                        </div>
                        <div style="color: #6c757d; font-size: 0.9rem;">@(Model?.CreatedAt.ToString("yyyy-MM-dd HH:mm") ?? "")</div>
                        <div class="ms-auto text-muted" style="font-size: 0.9rem;">@(Model?.ViewCount ?? 0) views</div>
                    </div>
                </div>
            </div>

            <hr style="border-color: #e9ecef; margin: 14px 0;"/>

            <div style="color: #212529; font-size: 1rem; line-height: 1.6;">
                @Html.Raw(HtmlSanitizerHelper.SanitizeAndFormat(Model?.Content ?? string.Empty))
            </div>

            @{
                // Avoid duplicate images: if the post content already includes an image with the
                // same file link (or filename), don't show that attachment again below the content.
                var contentHtml = (Model?.Content ?? string.Empty).ToLowerInvariant();
                var filteredAttachments = Model?.DiscussionAttachments?.Where(attachment =>
                {
                    if (attachment?.FileLink == null) return false;
                    var fileLinkLower = attachment.FileLink.ToLowerInvariant();
                    var fileName = System.IO.Path.GetFileName(fileLinkLower);

                    // If the content contains the full link or just the filename, skip the attachment
                    var isEmbedded = contentHtml.Contains(fileLinkLower) || (!string.IsNullOrWhiteSpace(fileName) && contentHtml.Contains(fileName));
                    return !isEmbedded;
                })?.ToList();

                if (filteredAttachments != null && filteredAttachments.Any())
                {
                    <div class="post-content ps-1 mb-3">
                        @foreach (var attachmentImage in filteredAttachments)
                        {
                            <img src="@attachmentImage.FileLink" alt="Attachment Image" class="img-fluid rounded mt-2 shadow-sm"
                                 style="max-height: 300px; object-fit: contain;" loading="lazy"/>
                        }
                    </div>
                }
            }

            <div class="d-flex justify-content-end align-items-center gap-1">
                <partial name="_ActionButtonTable" model="@Model"/>
            </div>
        </div>
    </div>

    <!-- Image Preview Modal for comment attachments (dynamically wired after comments are loaded) -->
    <div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body p-0 d-flex justify-content-center align-items-center">
                    <img id="modalPreviewImg" src="" alt="Preview" class="img-fluid rounded shadow"
                         style="background: #fff; max-height: 80vh; max-width: 100vw;"/>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Wire image preview handlers for server-rendered comments.
        document.addEventListener('DOMContentLoaded',
            function() {
                const modalImg = document.getElementById('modalPreviewImg');
                const previewModal = document.getElementById('imagePreviewModal');
                if (previewModal) previewModal.addEventListener('hidden.bs.modal', function() { modalImg.src = ''; });

                // delegate clicks for attachments (works for server-rendered content)
                document.body.addEventListener('click',
                    function(ev) {
                        const target = ev.target;
                        if (target && target.classList && target.classList.contains('comment-attachment-preview')) {
                            const src = target.getAttribute('data-img-src');
                            if (src) modalImg.src = src;
                        }
                    });
            });
    </script>

    <!-- Comments Section (server-rendered) -->
    <div class="mb-5" id="postCommentsContainer">
        @await Html.PartialAsync("_PostComments", Model)
    </div>
</div>

@* Include ban/trash modals for this single-post view so the action buttons can open them *@
@await Html.PartialAsync("_BanReason", Model, new ViewDataDictionary(ViewData) { { "BanModalId", $"banModal-{Model?.Id ?? 0}" } })
@await Html.PartialAsync("_TrashPost", Model, new ViewDataDictionary(ViewData) { { "TrashModalId", $"trashModal-{Model?.Id ?? 0}" } })

<script>
    // Small helpers for ban/trash modal UX on the Post Details page
    document.addEventListener('DOMContentLoaded',
        function() {
            try {
                // Focus the ban textarea when any ban modal is shown
                document.querySelectorAll('[id^="banModal-"]').forEach(function(modalEl) {
                    modalEl.addEventListener('shown.bs.modal',
                        function() {
                            try {
                                const ta = modalEl.querySelector('textarea');
                                if (ta) ta.focus();
                            } catch (e) { /* ignore */
                            }
                        });
                });

                // Disable submit buttons on moderation form submit to prevent double submits
                document.addEventListener('submit',
                    function(e) {
                        try {
                            const form = e.target;
                            if (!form) return;
                            const action = (form.getAttribute('action') || '').toLowerCase();
                            if (action.indexOf('banpost') !== -1 || action.indexOf('trashpost') !== -1 || action.indexOf('deletepost') !== -1 || action.indexOf('recoverpost') !== -1 || action.indexOf('unbanpost') !== -1 || (form.getAttribute('data-ajax') === 'true' && form.querySelector('input[name="id"], input[name="ids"]'))) {
                                const btns = form.querySelectorAll('button[type="submit"]');
                                btns.forEach(function(b) {
                                    b.disabled = true;
                                    b.dataset._disabled = '1';
                                });
                            }
                        } catch (err) { /* ignore */
                        }
                    },
                    true);

                // Clean up modal/backdrop after AJAX moderation actions (if using unobtrusive-ajax)
                if (window.jQuery) {
                    $(document).on('ajaxSuccess',
                        function(event, xhr, settings) {
                            try {
                                if (!settings || !settings.url) return;
                                const url = (settings.url || '').toLowerCase();
                                if (url.indexOf('/admin/discussion/trashpost') !== -1 || url.indexOf('/admin/discussion/banpost') !== -1 || url.indexOf('/admin/discussion/deletepost') !== -1) {
                                    try {
                                        // Use setTimeout to ensure modal animation completes before cleanup
                                        setTimeout(function() {
                                                if (window.bootstrap && typeof window.bootstrap.Modal === 'function') {
                                                    document.querySelectorAll('.modal.show, .modal').forEach(function(m) {
                                                        try {
                                                            const instance = window.bootstrap.Modal.getInstance(m);
                                                            if (instance) {
                                                                instance.hide();
                                                                instance.dispose();
                                                            } else {
                                                                m.classList.remove('show', 'fade');
                                                                m.style.display = 'none';
                                                                m.setAttribute('aria-hidden', 'true');
                                                                m.removeAttribute('aria-modal');
                                                            }
                                                        } catch (e) {
                                                        }
                                                    });
                                                } else {
                                                    try {
                                                        $('.modal').modal('hide').modal('dispose');
                                                    } catch (e) {
                                                    }
                                                    document.querySelectorAll('.modal.show, .modal').forEach(function(m) {
                                                        m.classList.remove('show', 'fade');
                                                        m.style.display = 'none';
                                                        m.setAttribute('aria-hidden', 'true');
                                                        m.removeAttribute('aria-modal');
                                                    });
                                                }

                                                // Remove any remaining backdrops and restore body state
                                                document.querySelectorAll('.modal-backdrop').forEach(function(b) {
                                                    if (b.parentNode) {
                                                        b.parentNode.removeChild(b);
                                                    }
                                                });

                                                // Restore body state
                                                document.body.classList.remove('modal-open');
                                                document.body.style.overflow = '';
                                                document.body.style.paddingRight = '';

                                                // Force a reflow to ensure styles are applied
                                                document.body.offsetHeight;
                                            },
                                            150);
                                    } catch (err) {
                                        console.error('Error cleaning up modal/backdrop after AJAX moderation action', err);
                                    }
                                }
                            } catch (err) { /* ignore */
                            }
                        });
                }
            } catch (err) { /* ignore */
            }
        });
</script>