@model IPagedList<BookCategory>
@{
    ViewBag.Title = "Export Book Categories";
}

<section>
    <div class="container my-5">
        <h2 class="text-center mb-4">@ViewBag.Title</h2>

        <div class="d-flex justify-content-between align-items-center mb-3 gap-1">
            <a asp-area="Admin" asp-controller="BookCategory" asp-action="Index" class="btn btn-secondary d-flex align-items-center">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Go Back
            </a>
            <button type="button"
                    data-message="Are you sure to export the book categories as ZIP?"
                    data-action="/Admin/BookCategory/ExportZip"
                    class="select-submit-btn btn btn-primary"
                    form="select-form">
                <i class="fa fa-download"></i> Export as ZIP
            </button>
        </div>

        <div id="table-ajax">
            <partial name="_Export"/>
        </div>

        <div class="d-flex justify-content-end">
            <button type="button"
                    data-message="Are you sure to export the book categories as ZIP?"
                    data-action="/Admin/BookCategory/ExportZip"
                    class="select-submit-btn btn btn-primary"
                    form="select-form">
                <i class="fa fa-download"></i> Export as ZIP
            </button>
        </div>
    </div>
</section>