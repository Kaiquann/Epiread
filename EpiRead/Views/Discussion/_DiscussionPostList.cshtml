@model DiscussionVm

@if (Model.DiscussionPosts != null && Model.DiscussionPosts.Any())
{
    <div class="discussion-posts">
        @foreach (var post in Model.DiscussionPosts)
        {
            <div class="discussion-card mb-3 p-3 rounded-4 shadow-sm">
                <div class="d-flex align-items-center mb-2">
                    <div class="me-3">
                        @if (!string.IsNullOrEmpty(post.User?.ProfileImageLink))
                        {
                            <img src="@post.User.ProfileImageLink" alt="User Avatar"
                                   loading="lazy"
                                 class="rounded-circle border border-secondary"
                                 style="width: 45px; height: 45px; object-fit: cover;">
                            @post.User?.UserName?[0].ToString().ToUpper()
                        }
                        else
                        {
                            <div class="avatar-circle bg-info text-dark fw-bold d-flex align-items-center justify-content-center"
                                 style="width: 45px; height: 45px; border-radius: 50%;">
                                @post.User?.UserName?[0].ToString().ToUpper()
                            </div>
                        }
                    </div>
                    <div>
                        @{ var displayName = post.User?.UserName ?? "Unknown";
                           if (string.Equals(post.User?.Role, "Author", System.StringComparison.OrdinalIgnoreCase)) displayName += " (author)";
                        }
                        <h6 class="mb-0 text-light fw-semibold">@displayName</h6>
                        <small class="text-secondary">@post.CreatedAt.ToString("f")</small>
                    </div>
                </div>

                <div class="post-content ps-1 mb-3">
                    <p class="text-light mb-0">@post.Title</p>
                    @* @if (post.DiscussionAttachments.Any())
                    {
                        foreach (var attachmentImage in post.DiscussionAttachments)
                        {
                            <img src="@attachmentImage.FileLink" alt="Attachment Image"
                                     loading="lazy"
                                 class="img-fluid rounded mt-2 shadow-sm"
                                 style="max-height: 300px; object-fit: contain;" />
                        }
                    } *@
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <!-- Left side: Views -->
                    <div class="text-secondary small d-flex align-items-center">
                        <i class="fas fa-eye me-1 text-info"></i>
                        <span>@post.ViewCount @((post.ViewCount == 1) ? "view" : "views")</span>
                    </div>

                    <!-- Right side: Like + Reply -->
                    <div class="d-flex align-items-center gap-3" id="discussionPost">
                        <!-- Like button -->
                        @{
                            var userId = Model.User?.Id; // assuming you pass CurrentUser to the view
                            bool isLiked = post.DiscussionLikeCounts.Any(l => l.UserId == userId);
                            int likeCount = post.DiscussionLikeCounts.Count(l => l.DiscussionPostId == post.Id);
                        }

                        <form asp-controller="Discussion" asp-action="ToggleLike"
                              data-ajax="true"
                              data-ajax-update="#discussionPost" data-ajax-mode="replace"
                              class="d-inline">
                            <input type="hidden" name="discussionPostId" value="@post.Id" />
                            <input type="hidden" name="bookId" value="@Model.Book.Id" />
                            <input type="hidden" name="source" value="book-forum" />
                            <button type="submit"
                                    class="btn btn-sm rounded-pill px-3 py-1 @(isLiked ? "btn-primary text-white" : "btn-outline-light")">
                                <i class="fas fa-thumbs-up me-1 @(isLiked ? "text-white" : "")"></i>
                                <span class="like-count">@likeCount</span>
                            </button>
                        </form>


                        <!-- comment button -->
                        <a asp-controller="Discussion" asp-action="DiscussionPostComment" asp-route-discussionPostId="@post.Id">
                            <button type="submit" class="btn btn-outline-info btn-sm rounded-pill px-3 py-1">
                                <i class="fas fa-reply me-1"></i> Go to Comment Page
                            </button>
                        </a>
                    </div>
                </div>

            </div>
        }
    </div>
}
else
{
    <div class="text-secondary text-center py-5">
        <i class="fas fa-comment-dots fa-3x mb-3 text-info"></i>
        <p class="mb-0">No discussion posts yet. Be the first to start a conversation!</p>
    </div>
}